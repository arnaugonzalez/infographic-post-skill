# === Infographic Skill — Environment Configuration ===
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Core generation (matplotlib) requires NO env vars.
# These are only needed for "pretty mode" (AI structuring + rendering).
# Benchmark behind these defaults: benchmark/RESULTS.md (Oct 2026).

# --- Backend & Model selection (v0.2) ---
# auto (default) picks session inside Claude Code or the first installed subscription CLI
# (claude, agy, codex, copilot, opencode) — never a paid API unless --backend api is requested.
INFG_BACKEND=
INFG_MODEL=

# --- Anthropic (Claude) — structuring (Haiku 5.5) and the Claude HTML renderer (Opus 5.5) ---
# Get your key at: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- Option A: Google AI Studio (recommended for the default max-quality image model) ---
# Get your key at: https://aistudio.google.com/apikey
INFG_API_KEY=

# --- Option B: Google Cloud Vertex AI (optional) ---
# Requires a GCP project with Vertex AI API enabled.
# Auth: uses Application Default Credentials (gcloud auth application-default login)
INFG_VERTEX_PROJECT=
INFG_VERTEX_LOCATION=us-central1

# --- Option C: Multi-Provider LLM Support (v1.0) ---
# Choose which LLM provider handles text/HTML generation.
# Default: gemini (uses INFG_API_KEY or Vertex credentials above).
INFG_LLM_PROVIDER=

# Override the LLM used for codebase structuring and LinkedIn posts.
# Leave empty for auto: claude-haiku-5-5 if ANTHROPIC_API_KEY is set, else gemini-3.8-flash.
#   claude-*        → Anthropic API     gemini-*  → Google AI Studio
#   vendor/model    → OpenRouter (e.g. anthropic/claude-sonnet-5.5)
# Benchmark (structuring, $/call): claude-haiku-5-5 $0.001 · gemini-3.8-flash $0.012 ·
#   claude-sonnet-5-5 $0.021 · claude-opus-5-5 $0.041 (most complete).
INFG_LLM_MODEL=

# Generic LLM API key — used when no provider-specific key is set.
INFG_LLM_API_KEY=

# Dedicated OpenRouter API key (takes precedence over INFG_LLM_API_KEY when provider=openrouter).
# Get your key at: https://openrouter.ai/keys
INFG_OPENROUTER_API_KEY=

# Override the default image model (gemini-3-pro-image).
# Only applies when --model flag is not explicitly passed on the CLI.
INFG_IMAGE_MODEL=
# Image resolution for Gemini image models: 1K | 2K (default) | 4K.
# At 1K the text is markedly less accurate (benchmark: publishable 2.5/10 vs 4.0/10 for flash).
INFG_IMAGE_SIZE=2K

# --- Display ---
# Set for headless/CI environments (no GUI):
# MPLBACKEND=Agg
